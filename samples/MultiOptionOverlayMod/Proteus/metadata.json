{
  "FormatVersion": 1,
  "Name": "Example Stocking Overlays (Bibo+)",
  "Author": "YourNameHere",

  "Presets": [
    {
      "Name": "Rose lace",
      "Description": "Roses with the gloves on, warmed a little.",
      "Options": {
        "Stocking Pattern": ["Roses"],
        "Gloves": ["Gloves"]
      },
      "Colors": {
        "Options": {
          "Stocking Pattern": {
            "Roses": [ { "Row": 16, "SubRowA": { "Diffuse": "#F3E2DA", "Opacity": -20 } } ]
          }
        }
      }
    },
    {
      "Name": "Bare stripes",
      "Description": "Stripes, no gloves, left the author's colours alone.",
      "Options": {
        "Stocking Pattern": ["Stripes"],
        "Gloves": ["None"]
      }
    }
  ],

  "OptionGroups": [
    {
      "PenumbraGroupName": "Stocking Pattern",
      "Options": [
        {
          "Name": "Roses",
          "Overlays": [
            {
              "MaterialGamePath": "chara/human/c0201/obj/body/b0001/material/v0001/mt_c0201b0001_bibo.mtrl",
              "Diffuse": "overlays/roses_d.png",
              "Normal":  "overlays/roses_n.png",
              "Index":   "overlays/roses_id.png"
            }
          ],
          "ColorTableRows": [
            { "Row": 16, "SubRowA": { "Diffuse": "#FFFFFF", "Emissive": 0.0 } }
          ]
        },
        {
          "Name": "Stripes",
          "Overlays": [
            {
              "MaterialGamePath": "chara/human/c0201/obj/body/b0001/material/v0001/mt_c0201b0001_bibo.mtrl",
              "Diffuse": "overlays/stripes_d.png"
            }
          ],
          "ColorTableRows": [
            { "Row": 16, "SubRowA": { "Diffuse": "#FFFFFF", "Emissive": 0.0 } }
          ]
        },
        {
          "Name": "Dots",
          "Overlays": [
            {
              "MaterialGamePath": "chara/human/c0201/obj/body/b0001/material/v0001/mt_c0201b0001_bibo.mtrl",
              "Diffuse": "overlays/dots_d.png"
            }
          ],
          "ColorTableRows": [
            { "Row": 16, "SubRowA": { "Diffuse": "#FFFFFF", "Emissive": 0.0 } }
          ]
        }
      ]
    },

    {
      "PenumbraGroupName": "Gloves",
      "Options": [
        {
          "Name": "None",
          "Overlays": []
        },
        {
          "Name": "Gloves",
          "Overlays": [
            {
              "MaterialGamePath": "chara/human/c0201/obj/body/b0001/material/v0001/mt_c0201b0001_bibo.mtrl",
              "Normal": "overlays/gloves_n.png"
            }
          ],
          "ColorTableRows": [
            { "Row": 16, "SubRowA": { "Diffuse": "#FFFFFF", "Emissive": 0.0 } }
          ]
        }
      ]
    }
  ]
