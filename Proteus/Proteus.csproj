<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Default to Release when no configuration is passed. Must be set before the Dalamud
       SDK props import, which otherwise defaults Configuration to Debug. This is why the
       SDK is imported explicitly below instead of via the Project Sdk="..." attribute. -->
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Dalamud.NET.Sdk" />

  <!-- Stamp the compile time into the assembly so the chat line on load can prove WHICH build is
       running. Dalamud loads plugins from a stream, so Assembly.Location is empty at runtime and the
       DLL's file timestamp is unreachable — this has to be baked in at compile time. Re-evaluated on
       every build; when MSBuild skips the compile because nothing changed, the old stamp is retained,
       which is correct because the assembly genuinely didn't change. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildStamp</_Parameter1>
      <_Parameter2>$([System.DateTime]::Now.ToString('MM-dd HH:mm:ss'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup>
    <Version>$(ProteusVersion)</Version>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- CI builds against the Dalamud STAGING SDK (test.yml downloads dalamud-distrib/stg/latest),
         which escalates warnings to errors; a local build uses whatever sits in Hooks/dev and does
         not. That gap let six warnings accumulate here and only surface as a red build on push, with
         nothing to reproduce them locally. Escalating here closes it: the same warning now fails at
         your desk, before the commit, on the same machine that can fix it. Deliberately NOT set in
         Proteus.Tests.csproj — a test project's warnings are its own business and blocking `dotnet
         test` on one helps nobody. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Dalamud plugin manifest -->
    <Name>Proteus</Name>
    <Author>Solona</Author>
    <Punchline>Automatic overlay compositor for Penumbra mods</Punchline>
    <Description>Overlay compositor for Penumbra. Discovers mods with a Proteus/ sidecar, composites their overlay textures in Penumbra priority order, and maintains a single managed mod at priority 999. Type /proteus to open the status window, or /proteus config for settings.</Description>
    <ApplicableVersion>any</ApplicableVersion>
    <DalamudApiLevel>15</DalamudApiLevel>
    <Tags>texture;overlay;compositor;penumbra;skin;mod</Tags>
    <CategoryTags>utility</CategoryTags>
    <!-- The icon shown in /xlplugins. Dalamud only reads the on-disk images\icon.png for DEV
         plugins; for anyone who installed from the plugin repo it fetches this URL instead, so
         the file has to exist on main under this exact (case-sensitive) path. Note that the
         end-user listing in solona-m/plugins/repo.json carries its own IconUrl — this property
         does not propagate there. -->
    <IconUrl>https://raw.githubusercontent.com/solona-m/proteus/main/Proteus/images/icon.png</IconUrl>
    <RepoUrl>https://github.com/solona-m/proteus</RepoUrl>
    <!-- Shown under the plugin entry after an update. Deliberately empty here: the value comes from
         the annotated tag's message, which release.yml reads into a Changelog environment variable
         before invoking dotnet build (MSBuild surfaces environment variables as properties, and this
         Condition yields to one when set). It cannot come from the GitHub release body — that
         release is created by the workflow long after the build. Hardcoding text here would ship the
         same stale line on every later release; an absent changelog is honest, a wrong one is not. -->
    <Changelog Condition="'$(Changelog)' == ''"></Changelog>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StbImageSharp" Version="2.*" />
    <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <PackageReference Include="BCnEncoder.Net" Version="2.*" />
    <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
<Content Include="..\THIRD_PARTY_NOTICES.txt" Link="THIRD_PARTY_NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Native SIMD block-compressor (bc7enc + rgbcx, built via native\src\build.bat). Ships next to the
         plugin DLL; TextureLoader P/Invokes it for fast BC7/BC5 and falls back to BCnEncoder.Net if absent. -->
    <Content Include="native\proteus_bcn.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>proteus_bcn.dll</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- The 32 sphere-map slices, as one 64x2048 vertical strip. Lumina cannot decode the game's
         ARRAY texture (chara/common/texture/sphere_d_array.tex) and Penumbra only manages it by
         slicing the live GPU texture through native interop — so the slices are extracted offline
         and shipped instead. -->
    <EmbeddedResource Include="Resources\sphere_d_array.png" />
    <!-- Shown for sphere-map index 0 ("no sphere") in the picker, so it doesn't look like a real sphere. -->
    <EmbeddedResource Include="Resources\none.png" />
    <!-- The status window's header band: a 512x128 crop from the middle of images\icon.png, where the
         logo's yellow-to-red sweep is widest. Cropped offline rather than embedding the 512x512 original
         and sampling it at draw time — a fifth of the size, and the framing is a decision rather than an
         accident. Separate from the images\icon.png None item below, which must keep landing on disk
         because that is where Dalamud reads a dev-loaded plugin's installer icon from. -->
    <EmbeddedResource Include="Resources\header.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lands next to the DLL as bin\...\images\icon.png, which is where Dalamud looks when the
         plugin is dev-loaded (PluginImageCache reads <DllDir>\images\icon.png for IsDev plugins
         only). Deliberately unconditional: a missing file should fail the build rather than
         silently ship an iconless plugin. Must stay square and <= 512x512 or Dalamud rejects it. -->
    <None Include="images\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Starter scroll-effect library. Shipped alongside the plugin and seeded into the user's
         global Effects folder on first run (SidecarDiscoveryService.SeedDefaultEffects), so every
         gear overlay's Effect dropdown has something to choose from out of the box. -->
    <Content Include="DefaultEffects\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>DefaultEffects\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Penumbra.Api\Penumbra.Api.csproj" />
    <ProjectReference Include="..\Glamourer\Glamourer.Api\Glamourer.Api.csproj" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Dalamud.NET.Sdk" />

</Project>
